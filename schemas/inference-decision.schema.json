{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/inference-decision.schema.json",
  "title": "InferenceDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "actionVi",
    "threshold",
    "unresolvedClaimIds",
    "concludedClaimIds",
    "selectedQuestions",
    "crossDomainInsights",
    "storyBlueprint",
    "questionMix",
    "reason",
    "limits"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["conclude", "ask", "abstain"]
    },
    "actionVi": {
      "type": "string",
      "enum": ["ket_luan", "hoi_them", "tam_dung"]
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unresolvedClaimIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "concludedClaimIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "selectedQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "questionText", "claimIds", "expectedConfidenceGain"],
        "properties": {
          "questionId": { "type": "string" },
          "questionText": { "type": "string" },
          "scope": {
            "type": "string",
            "enum": ["past", "present"]
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "phu_the",
                "thien_di",
                "quan_loc",
                "phuc_duc",
                "phu_mau",
                "huynh_de",
                "menh",
                "dien_trach",
                "no_boc",
                "tat_ach",
                "tai_bach",
                "tu_tuc"
              ]
            }
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "expectedConfidenceGain": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "crossDomainInsights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focusDomains", "relatedDomains", "note"],
      "properties": {
        "focusDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "phu_the",
              "thien_di",
              "quan_loc",
              "phuc_duc",
              "phu_mau",
              "huynh_de",
              "menh",
              "dien_trach",
              "no_boc",
              "tat_ach",
              "tai_bach",
              "tu_tuc"
            ]
          }
        },
        "relatedDomains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "score"],
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "phu_the",
                  "thien_di",
                  "quan_loc",
                  "phuc_duc",
                  "phu_mau",
                  "huynh_de",
                  "menh",
                  "dien_trach",
                  "no_boc",
                  "tat_ach",
                  "tai_bach",
                  "tu_tuc"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "storyBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "seedDomains", "linkedDomains", "narrativeOrder", "guidance"],
      "properties": {
        "question": { "type": "string" },
        "seedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "phu_the",
              "thien_di",
              "quan_loc",
              "phuc_duc",
              "phu_mau",
              "huynh_de",
              "menh",
              "dien_trach",
              "no_boc",
              "tat_ach",
              "tai_bach",
              "tu_tuc"
            ]
          }
        },
        "linkedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "phu_the",
              "thien_di",
              "quan_loc",
              "phuc_duc",
              "phu_mau",
              "huynh_de",
              "menh",
              "dien_trach",
              "no_boc",
              "tat_ach",
              "tai_bach",
              "tu_tuc"
            ]
          }
        },
        "narrativeOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "phu_the",
              "thien_di",
              "quan_loc",
              "phuc_duc",
              "phu_mau",
              "huynh_de",
              "menh",
              "dien_trach",
              "no_boc",
              "tat_ach",
              "tai_bach",
              "tu_tuc"
            ]
          }
        },
        "guidance": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "questionMix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "strategyVi", "scores", "targetTotals", "remainingTargets", "suggestedThisRound"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["past_heavy", "balanced", "present_heavy"]
        },
        "strategyVi": {
          "type": "string",
          "enum": ["uu_tien_qua_khu", "can_bang", "uu_tien_hien_tai"]
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pastValidationScore", "presentStateClarity"],
          "properties": {
            "pastValidationScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "presentStateClarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "targetTotals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["past", "present"],
          "properties": {
            "past": { "type": "integer", "minimum": 0 },
            "present": { "type": "integer", "minimum": 0 }
          }
        },
        "remainingTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["past", "present"],
          "properties": {
            "past": { "type": "integer", "minimum": 0 },
            "present": { "type": "integer", "minimum": 0 }
          }
        },
        "suggestedThisRound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["past", "present"],
          "properties": {
            "past": { "type": "integer", "minimum": 0 },
            "present": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "reason": { "type": "string" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRounds", "maxQuestionsPerRound", "maxTotalQuestions"],
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 1 },
        "maxQuestionsPerRound": { "type": "integer", "minimum": 1 },
        "maxTotalQuestions": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
